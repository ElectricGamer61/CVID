# Cvideo backend config.
# Copy this to  backend/.env  and fill in your keys.
# .env is gitignored and NEVER pushed to GitHub - keys stay on this machine.

# =====================================================================
# BARE-BONES MODE (laptop) - CPU Whisper for transcription, OpenAI for
# writing. No CUDA, no local LLM, no learning loop. The smallest working
# setup (install with requirements-bare.txt).
# =====================================================================

# Transcription:  local = faster-whisper on this machine, free and offline, no key
#                         (uses the GPU when there is one, CPU otherwise)
#                 elevenlabs = cloud Scribe, needs ELEVENLABS_API_KEY below
# `elevenlabs` with no key set falls back to local, so an upload never dead-ends.
CVIDEO_DEFAULT_TRANSCRIBE=local

# Whisper model. Blank = large-v3 on the GPU, `small` on the CPU (a laptop CPU takes
# many minutes per clip on large-v3). Set CVIDEO_WHISPER_MODEL to pin one everywhere,
# or CVIDEO_WHISPER_MODEL_CPU to change only the CPU one.
#CVIDEO_WHISPER_MODEL=
#CVIDEO_WHISPER_MODEL_CPU=small
# Set to `cpu` to never touch the GPU (use this if CUDA crashes the worker).
#CVIDEO_WHISPER_DEVICE=auto
# Biggest model download Cvideo will start on its OWN, in MB. Models are fetched on first
# use, and large-v3 is 3.1 GB - too long a wait to hand someone for their first clip. A
# model already downloaded is used whatever its size, and CVIDEO_WHISPER_MODEL above
# overrides this outright; raise it if you want a big model fetched automatically.
#CVIDEO_WHISPER_MAX_DOWNLOAD_MB=700
# Seconds of TOTAL silence from the transcription worker before it is cancelled and the
# project is marked failed. It reports megabytes while downloading and segments while
# transcribing, so silence means wedged - not slow.
#CVIDEO_TRANSCRIBE_STALL_SEC=900

# Brain (writes scripts / hooks / descriptions+tags / picks moments):
#   openai    = cloud GPT, tiny install, needs OPENAI_API_KEY below (bare-bones default)
#   gemini    = cloud Gemini, needs GEMINI_API_KEY (install google-generativeai)
#   ollama    = local AI, fully offline/private, needs the 6.6 GB model + `ollama serve`
#   heuristic = no AI at all; you paste your own scripts and write your own captions
CVIDEO_DEFAULT_BRAIN=openai

# Learning loop OFF for bare bones (it feeds past winners back into the AI; harmless but
# unused here). Set to `on` if you later want the AI to learn from your Results numbers.
CVIDEO_LEARNING=off

# =====================================================================
# ElevenLabs - AI voiceover, and optionally cloud transcription (OPTIONAL:
# transcription already works offline on the CPU without it)
# =====================================================================
ELEVENLABS_API_KEY=
# Your cloned voice "MasterDee". Change to any ElevenLabs voice id you like.
CVIDEO_ELEVENLABS_VOICE_ID=vXfZUSkDGskIJTG9SxRR

# =====================================================================
# OpenAI - the cloud brain (REQUIRED when CVIDEO_DEFAULT_BRAIN=openai)
# =====================================================================
OPENAI_API_KEY=
# Which GPT model to use (default gpt-4o-mini - cheap + fast). Set to whatever you use.
CVIDEO_OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# Publishing via Upload-Post - OPTIONAL (only needed to actually post).
# Leave blank to stay in safe dry-run mode (logs instead of posting).
# =====================================================================
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_TIMEZONE=America/New_York

# =====================================================================
# OPTIONAL extras
# =====================================================================
# Google Sheet perf webhook (leave blank = perf logging stays local):
PERF_SHEET_WEBHOOK_URL=
# Shoot Drop watched folder (leave blank = in-app drop zone only):
SHOOT_DROP_DIR=
