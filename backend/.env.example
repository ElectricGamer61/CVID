# Cvideo backend config.
# Copy this to  backend/.env  and fill in your keys.
# .env is gitignored and NEVER pushed to GitHub - keys stay on this machine.

# =====================================================================
# LEAN MODE (laptop / no GPU / no local LLM) - the recommended setup.
# =====================================================================

# Transcription: use ElevenLabs (cloud) so no local Whisper/GPU is needed.
CVIDEO_DEFAULT_TRANSCRIBE=elevenlabs

# Brain: no local ollama. "heuristic" = simple rules, no LLM (you bring scripts
# from your Claude subscription and paste them in). Set to "gemini" instead if you
# want in-app AI script/hook writing (then fill GEMINI_API_KEY below).
CVIDEO_DEFAULT_BRAIN=heuristic

# =====================================================================
# ElevenLabs - transcription + AI voiceover (REQUIRED in lean mode)
# =====================================================================
ELEVENLABS_API_KEY=
# Your cloned voice "MasterDee". Change to any ElevenLabs voice id you like.
CVIDEO_ELEVENLABS_VOICE_ID=vXfZUSkDGskIJTG9SxRR

# =====================================================================
# Publishing via Upload-Post - OPTIONAL (only needed to actually post).
# Leave blank to stay in safe dry-run mode (logs instead of posting).
# =====================================================================
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_TIMEZONE=America/New_York

# =====================================================================
# OPTIONAL extras
# =====================================================================
# Cloud LLM brain (only used if CVIDEO_DEFAULT_BRAIN=gemini):
GEMINI_API_KEY=
# Google Sheet perf webhook (leave blank = perf logging stays local):
PERF_SHEET_WEBHOOK_URL=
# Shoot Drop watched folder (leave blank = in-app drop zone only):
SHOOT_DROP_DIR=
